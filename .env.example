# ---------------------------------------------------------------------------
# AuriomHQ AI Visibility Analyzer — environment variables
# Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=./data/auriomhq.db
# Used when generating absolute share links behind a proxy (optional)
PUBLIC_BASE_URL=
# Only enable when running behind a trusted reverse proxy (uses X-Forwarded-For)
TRUST_PROXY=0
# Comma separated list, only needed if API and frontend are on different origins
CORS_ORIGINS=

# Crawler
CRAWLER_USER_AGENT=AuriomHQ-AI-Visibility-Analyzer/1.0 (+https://auriomhq.work; audit bot)
CRAWL_MAX_PAGES=10
CRAWL_MAX_PAGES_HARD_LIMIT=25
CRAWL_CONNECT_TIMEOUT=8
CRAWL_READ_TIMEOUT=15
CRAWL_TOTAL_TIMEOUT=120
CRAWL_MAX_RESPONSE_BYTES=3000000
CRAWL_MAX_REDIRECTS=5
CRAWL_LINK_CHECK_LIMIT=25
CRAWL_PER_HOST_DELAY=0.35
# NEVER enable in production — only for local development against test servers
CRAWL_ALLOW_PRIVATE_TARGETS=0

# Rate limiting
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_AUDITS_PER_WINDOW=10
MAX_CONCURRENT_AUDITS=3
IP_HASH_SALT=change-me-per-deployment

# Optional AI layer (OpenAI-compatible endpoint). Leave AI_ENABLED=0 to run
# entirely on the deterministic rule-based engine.
AI_ENABLED=0
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TIMEOUT_SECONDS=45

# Brand / lead generation
BRAND_NAME=AuriomHQ
PRODUCT_NAME=AI Visibility Analyzer
BRAND_URL=https://auriomhq.work
CONTACT_URL=https://auriomhq.work/contact
CONTACT_EMAIL=
# Optional: POST lead payloads to Slack/Zapier/Make/CRM webhook
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
